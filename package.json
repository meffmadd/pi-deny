{
  "name": "pi-deny",
  "version": "0.2.0",
  "description": "Gitignore-like shell command blocklist for CI, pre-commit hooks, and interactive use.",
  "type": "module",
  "main": "./pi-deny/engine.ts",
  "bin": {
    "bash-deny": "./pi-deny/cli.ts"
  },
  "files": ["pi-deny/", "AGENTS.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts tests/scenarios/*.test.ts tests/cli/*.test.ts",
    "bench": "node --import tsx scripts/bench.ts"
  },
  "keywords": ["shell", "guard", "security", "bash", "cli"],
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.0.0"
  }
}
